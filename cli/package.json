{
	"name": "commonspace",
	"version": "0.1.2",
	"description": "A local-first workspace for projects, channels, direct messages, and coding agents.",
	"private": true,
	"license": "MIT",
	"keywords": [
		"agent-client-protocol",
		"ai-agents",
		"coding-agents",
		"collaboration",
		"developer-tools",
		"local-first",
		"mcp",
		"nodejs",
		"react",
		"typescript"
	],
	"type": "module",
	"bin": {
		"commonspace": "dist/index.js"
	},
	"files": [
		"dist",
		"ui-dist"
	],
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/commonspaceai/commonspace.git",
		"directory": "cli"
	},
	"homepage": "https://github.com/commonspaceai/commonspace#readme",
	"bugs": {
		"url": "https://github.com/commonspaceai/commonspace/issues"
	},
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"@agentclientprotocol/claude-agent-acp": "0.79.0",
		"@agentclientprotocol/codex-acp": "1.12.0",
		"@agentclientprotocol/sdk": "1.4.0",
		"@huggingface/transformers": "4.3.0",
		"@modelcontextprotocol/sdk": "1.30.0",
		"express": "^5.1.0",
		"jsonc-parser": "3.3.1",
		"node-notifier": "10.0.1",
		"onnxruntime-node": "1.30.0",
		"pino": "^10.0.0",
		"zod": "^4.6.5"
	},
	"scripts": {
		"build": "node esbuild.config.mjs",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"clean": "node ../scripts/clean.mjs dist ui-dist"
	},
	"devDependencies": {
		"esbuild": "0.28.2",
		"typescript": "6.0.3"
	}
}
