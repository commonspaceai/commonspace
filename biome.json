{
	"$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
	"extends": ["biome-anti-slop/recommended"],
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": ["**", "!ui/public/mockServiceWorker.js"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"complexity": {
				"noExcessiveCognitiveComplexity": {
					"level": "warn",
					"options": { "maxAllowedComplexity": 15 }
				},
				"noExcessiveLinesPerFunction": {
					"level": "warn",
					"options": { "maxLines": 100 }
				},
				"noForEach": "warn",
				"useMaxParams": {
					"level": "warn",
					"options": { "max": 4 }
				}
			},
			"nursery": {
				"noComponentHookFactories": "error",
				"noFloatingPromises": "error",
				"noMisusedPromises": "error",
				"noUnsafeTypeAssertion": "error",
				"useExhaustiveSwitchCases": "error"
			},
			"performance": {
				"noBarrelFile": "warn",
				"noReExportAll": "warn"
			},
			"style": {
				"noNonNullAssertion": "error",
				"noParameterAssign": "warn",
				"noRestrictedImports": "error"
			},
			"suspicious": {
				"noExplicitAny": "error",
				"noImportCycles": "error",
				"noConsole": "warn"
			}
		}
	},
	"overrides": [
		{
			"includes": [
				"packages/shared/src/contracts.ts",
				"ui/src/settings-operation.ts"
			],
			"linter": { "rules": { "suspicious": { "noConstEnum": "off" } } }
		}
	],
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
