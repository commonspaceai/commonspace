{
	"$schema": "https://cdn.jsdelivr.net/npm/@cursorlens/schema@1/environment.json",
	"name": "Commonspace Development",
	"repos": [
		{
			"url": "https://github.com/commonspaceai/commonspace.git"
		}
	],
	"runtime": {
		"os": "ubuntu-24.04",
		"arch": "amd64"
	},
	"install": [
		{
			"command": ["pnpm", "install", "--frozen-lockfile"],
			"description": "Install locked dependencies"
		}
	],
	"commands": {
		"lint": {
			"command": ["sh", "-c", "pnpm biome:check && pnpm lint"],
			"description": "Run Biome and ESLint checks"
		},
		"typecheck": {
			"command": ["pnpm", "typecheck"],
			"description": "Check TypeScript contracts"
		},
		"test": {
			"command": ["pnpm", "test"],
			"description": "Run unit and integration tests"
		},
		"build": {
			"command": ["pnpm", "build"],
			"description": "Build all packages"
		}
	}
}
