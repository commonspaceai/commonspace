		"test-storybook": "node ../scripts/run-storybook-tests.mjs run",
		"test-storybook:watch": "node ../scripts/run-storybook-tests.mjs watch",
		"test-storybook:smoke": "node ../scripts/run-storybook-tests.mjs smoke"
	},
	"dependencies": {
		"@base-ui/react": "1.8.0",
		"@commonspace/shared": "workspace:*",
		"@tanstack/react-router": "1.170.35",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"lucide-react": "1.45.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"streamdown": "2.6.0",
		"tailwind-merge": "3.6.0",
		"tw-animate-css": "1.4.0"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "5.3.1",
		"@storybook/addon-a11y": "^10.6.0",
		"@storybook/addon-docs": "^10.6.0",
