		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"@vitest/browser-playwright": "4.1.11",
		"@vitest/coverage-v8": "4.1.11",
		"mockdate": "3.0.5",
		"msw": "2.15.0",
		"msw-storybook-addon": "^3.0.0",
		"shadcn": "4.21.0",
		"storybook": "^10.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "6.0.3",
		"vite": "^8.3.0"
