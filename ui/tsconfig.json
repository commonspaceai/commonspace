{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"jsx": "react-jsx",
		"types": ["vite/client"],
		"paths": {
			"@/*": ["./src/*"],
			"@commonspace/shared": ["../packages/shared/src/index.ts"]
		}
	},
	"include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"]
}
